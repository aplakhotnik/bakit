# BA-Kit — ignore installer-generated and workspace output

# Generated by the installer when targeting an agent/IDE (source of truth is skills/)
.github/prompts/
.claude/commands/
.cursor/commands/
.agents/skills/
.bakit/skills/

# Editor settings the installer may write
.vscode/settings.json

# BA workspaces created at runtime
workspace/

# OS noise
.DS_Store
